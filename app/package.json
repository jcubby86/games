{
  "name": "games-app",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix --cache",
    "lint:check": "eslint",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:favicon": "node scripts/generate-favicon.ts"
  },
  "dependencies": {
    "@games/shared": "*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.18.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "immutable": "^5.1.9",
    "react": "^19.2.4",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.5",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "sass": "^1.105.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
